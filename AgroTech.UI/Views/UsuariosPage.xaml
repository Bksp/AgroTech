<Page x:Class="AgroTech.UI.Views.UsuariosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="UsuariosPage">
    
    <Grid Margin="30,20,30,20" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TextBlock FontTypography="Title" Text="Gestión de Usuarios del Sistema" Margin="0,0,0,20" Grid.Row="0"/>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Grid.Row="1" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre Completo" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtNombreCompleto" Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ej. Ana Fernández"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Correo Electrónico" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtCorreo" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="usuario@agrotech.cl"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Rol del Sistema" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbRoles" Height="35" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRol}" DisplayMemberPath="NombreRol"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contraseña Temporal" Margin="0,0,0,5"/>
                        <ui:PasswordBox x:Name="txtPassTemp" PlaceholderText="Dejar en blanco para no cambiarla"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Limpiar" Appearance="Secondary" Margin="0,0,10,0" Command="{Binding LimpiarCommand}" CommandParameter="{Binding ElementName=txtPassTemp}"/>
                    <ui:Button Content="Reactivar" Appearance="Secondary" Margin="0,0,10,0" Command="{Binding ReactivarCommand}" CommandParameter="{Binding ElementName=txtPassTemp}"/>
                    <ui:Button Content="Suspender Usuario" Appearance="Danger" Margin="0,0,10,0" Command="{Binding EliminarCommand}" CommandParameter="{Binding ElementName=txtPassTemp}" Icon="{ui:SymbolIcon Delete24}"/>
                    <ui:Button Content="Modificar" Appearance="Caution" Margin="0,0,10,0" Command="{Binding ModificarCommand}" CommandParameter="{Binding ElementName=txtPassTemp}" Icon="{ui:SymbolIcon Edit24}"/>
                    <ui:Button Content="Registrar Usuario" Appearance="Primary" Command="{Binding RegistrarCommand}" CommandParameter="{Binding ElementName=txtPassTemp}" Icon="{ui:SymbolIcon PersonAdd24}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
            <DataGrid x:Name="GridUsuarios" AutoGenerateColumns="False" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding SelectedUsuario}"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorTransparentBrush}"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdUsuario}" Width="50"/>
                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                    <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding CorreoElectronico}" Width="230"/>
                    <DataGridTextColumn Header="Rol" Binding="{Binding Rol.NombreRol}" Width="130"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                    <DataGridTextColumn Header="Fecha Registro" Binding="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

