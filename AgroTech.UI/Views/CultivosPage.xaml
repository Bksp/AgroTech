<Page x:Class="AgroTech.UI.Views.CultivosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Gestión de Cultivos">
    
    <Grid Margin="30,20,30,20" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBlock FontTypography="Title" Text="Gestión de Cultivos" Margin="0,0,0,20" Grid.Row="0"/>

        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,20">
            <DockPanel>
                <ui:TextBlock DockPanel.Dock="Top" FontTypography="Subtitle" Text="Lista de Cultivos" Margin="5,0,0,10"/>
                <DataGrid x:Name="GridCultivos" AutoGenerateColumns="False" ItemsSource="{Binding Cultivos}" SelectedItem="{Binding CultivoSeleccionado, Mode=TwoWay}"
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorTransparentBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdCultivo}" Width="50"/>
                        <DataGridTextColumn Header="Parcela" Binding="{Binding Parcela.Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Cultivo" Binding="{Binding TipoCultivo}" Width="150"/>
                        <DataGridTextColumn Header="Siembra" Binding="{Binding FechaSiembra, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Cosecha Est." Binding="{Binding FechaEstimadaCosecha, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="{Binding AccionesVisibility}">
            <StackPanel>
                <ui:TextBlock FontTypography="Subtitle" Text="Editar Cultivo Seleccionado" Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estado" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding EstadosDisponibles}" SelectedItem="{Binding EstadoSeleccionado, Mode=TwoWay}" Height="35" IsEnabled="{Binding PuedeEditar}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha de Siembra" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaSiembraSeleccionada, Mode=TwoWay}" Height="35" IsEnabled="{Binding PuedeEditar}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha Est. Cosecha" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaCosechaSeleccionada, Mode=TwoWay}" Height="35" IsEnabled="{Binding PuedeEditar}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <ui:Button Content="Eliminar" Appearance="Danger" Margin="0,0,10,0" Command="{Binding EliminarCommand}" Icon="{ui:SymbolIcon Delete24}"/>
                    <ui:Button Content="Guardar Cambios" Appearance="Primary" Command="{Binding GuardarCambiosCommand}" Icon="{ui:SymbolIcon Save24}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
