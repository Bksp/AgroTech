<Page x:Class="AgroTech.UI.Views.ParcelasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ParcelasPage">
    
    <Grid Margin="30,20,30,20" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TextBlock FontTypography="Title" Text="Registrar Nueva Parcela y Cultivo" Margin="0,0,0,20" Grid.Row="0"/>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Grid.Row="1" Margin="0,0,0,20">
            <StackPanel>
                <ui:TextBlock FontTypography="Subtitle" Text="Datos de la Parcela" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre de la Parcela" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtNombreParcela" Text="{Binding NombreParcela, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PuedeEditar}" PlaceholderText="Ej. Invernadero Norte"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ubicación" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtUbicacion" Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PuedeEditar}" PlaceholderText="Ej. Sector Maule"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Dimensiones (m²)" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtDimensiones" Text="{Binding Dimensiones, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PuedeEditar}" PlaceholderText="Ej. 500"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,20"/>

                <ui:TextBlock FontTypography="Subtitle" Text="Datos del Cultivo" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo de Cultivo" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbTipoCultivo" ItemsSource="{Binding TiposDeCultivo}" SelectedItem="{Binding SelectedTipoCultivo}" IsEnabled="{Binding PuedeEditar}" Height="35" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha de Siembra" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpFechaSiembra" SelectedDate="{Binding FechaSiembra}" IsEnabled="{Binding PuedeEditar}" Height="35"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha Est. Cosecha" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpFechaCosecha" SelectedDate="{Binding FechaCosecha}" IsEnabled="{Binding PuedeEditar}" Height="35"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="panelAccionesParcela" Visibility="{Binding AccionesVisibility}" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Limpiar Campos" Appearance="Secondary" Margin="0,0,10,0" Command="{Binding LimpiarCommand}"/>
                    <ui:Button Content="Guardar Registro" Appearance="Primary" Command="{Binding GuardarCommand}" Icon="{ui:SymbolIcon Save24}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" FontTypography="Subtitle" Text="Parcelas Registradas" Margin="5,0,0,10"/>
                    <ui:DataGrid x:Name="GridParcelas" AutoGenerateColumns="False" ItemsSource="{Binding Parcelas}"
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0">
                        <ui:DataGrid.Resources>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:DataGrid.Resources>
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdParcela}" Width="40"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="130"/>
                            <DataGridTextColumn Header="m²" Binding="{Binding DimensionesM2}" Width="90"/>
                            <DataGridTextColumn Header="Registro" Binding="{Binding FechaRegistro, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" FontTypography="Subtitle" Text="Cultivos Registrados" Margin="5,0,0,10"/>
                    <ui:DataGrid x:Name="GridCultivos" AutoGenerateColumns="False" ItemsSource="{Binding Cultivos}"
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0">
                        <ui:DataGrid.Resources>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:DataGrid.Resources>
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="Parcela" Binding="{Binding Parcela.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cultivo" Binding="{Binding TipoCultivo}" Width="110"/>
                            <DataGridTextColumn Header="Siembra" Binding="{Binding FechaSiembra, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Cosecha Est." Binding="{Binding FechaEstimadaCosecha, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

