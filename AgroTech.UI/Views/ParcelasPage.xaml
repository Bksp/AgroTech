<Page x:Class="AgroTech.UI.Views.ParcelasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ParcelasPage">
    
    <Grid Margin="30,20,30,20" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TextBlock FontTypography="Title" Text="Registrar Nueva Parcela y Cultivo" Margin="0,0,0,20" Grid.Row="0"/>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Grid.Row="1" Margin="0,0,0,20">
            <StackPanel>
                <ui:TextBlock FontTypography="Subtitle" Text="Datos de la Parcela" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre de la Parcela" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtNombreParcela" PlaceholderText="Ej. Invernadero Norte"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ubicación" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtUbicacion" PlaceholderText="Ej. Sector Maule"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Dimensiones (m²)" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtDimensiones" PlaceholderText="Ej. 500"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,20"/>

                <ui:TextBlock FontTypography="Subtitle" Text="Datos del Cultivo" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo de Cultivo" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbTipoCultivo" Height="35">
                            <ComboBoxItem Content="Seleccione un cultivo..." IsSelected="True"/>
                            <ComboBoxItem Content="Tomates"/>
                            <ComboBoxItem Content="Lechugas"/>
                            <ComboBoxItem Content="Zanahorias"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha de Siembra" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpFechaSiembra" Height="35"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha Est. Cosecha" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpFechaCosecha" Height="35"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="panelAccionesParcela" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Limpiar Campos" Appearance="Secondary" Margin="0,0,10,0" Click="LimpiarParcelas_Click"/>
                    <ui:Button Content="Guardar Registro" Appearance="Primary" Click="GuardarParcela_Click" Icon="{ui:SymbolIcon Save24}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" FontTypography="Subtitle" Text="Parcelas Registradas" Margin="5,0,0,10"/>
                    <DataGrid x:Name="GridParcelas" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorTransparentBrush}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdParcela}" Width="40"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="130"/>
                            <DataGridTextColumn Header="m²" Binding="{Binding DimensionesM2}" Width="90"/>
                            <DataGridTextColumn Header="Registro" Binding="{Binding FechaRegistro, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                <DockPanel>
                    <ui:TextBlock DockPanel.Dock="Top" FontTypography="Subtitle" Text="Cultivos Registrados" Margin="5,0,0,10"/>
                    <DataGrid x:Name="GridCultivos" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorTransparentBrush}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parcela" Binding="{Binding Parcela.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cultivo" Binding="{Binding TipoCultivo}" Width="110"/>
                            <DataGridTextColumn Header="Siembra" Binding="{Binding FechaSiembra, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Cosecha Est." Binding="{Binding FechaEstimadaCosecha, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

