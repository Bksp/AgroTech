<ui:FluentWindow x:Class="AgroTech.UI.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:AgroTech.UI.Views"
        Title="AgroTech SmartFields - Dashboard" Height="750" Width="1100"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="🌱 AgroTech - Panel Principal" Grid.Row="0" />

        <Border Grid.Row="1" Padding="20,8" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <ui:TextBlock x:Name="txtUsuarioSesion" FontTypography="BodyStrong" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <ui:Button x:Name="btnCerrarSesion" Content="Cerrar sesión" Appearance="Secondary"
                           DockPanel.Dock="Right" Padding="10,4" Click="CerrarSesion_Click"/>
            </DockPanel>
        </Border>

        <!-- NavigationView de WPF-UI (Estilo Windows 11 Nativo) -->
        <ui:NavigationView Grid.Row="2"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="navParcelas" Content="Parcelas y Cultivos" Icon="{ui:SymbolIcon Map24}" TargetPageType="{x:Type views:ParcelasPage}" />
                <ui:NavigationViewItem x:Name="navUsuarios" Content="Gestión de Usuarios" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type views:UsuariosPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

    </Grid>
</ui:FluentWindow>
