<ui:FluentWindow x:Class="AgroTech.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AgroTech.UI"
        mc:Ignorable="d"
        Title="AgroTech SmartFields - Iniciar Sesión" Height="500" Width="400"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">
    
    <Grid>
        <ui:TitleBar Title="🌱 AgroTech" />

        <StackPanel VerticalAlignment="Center" Margin="40">
            <TextBlock Text="🌱" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <ui:TextBlock FontTypography="Title" Text="AgroTech" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <ui:TextBlock FontTypography="Body" Text="Gestión Agrícola Inteligente" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,40"/>

            <ui:TextBox x:Name="txtUsername" PlaceholderText="Usuario Institucional" Icon="{ui:SymbolIcon Person24}" Margin="0,0,0,15"/>
            <ui:PasswordBox x:Name="txtPassword" PlaceholderText="Contraseña" Icon="{ui:SymbolIcon Password24}" Margin="0,0,0,25"/>

            <ui:Button Content="Iniciar Sesión" Appearance="Primary" HorizontalAlignment="Stretch" Click="Login_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
